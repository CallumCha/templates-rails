<% provide(:title, params[:id].gsub('/', ' / ').titleize) %>

<div>
  <% Dir.children(Rails.root.join("app/views/#{Templates.views_path}/#{params[:id]}")).excluding('partials').sort.each do |child| %>
    <%= link_to child.chomp('.html.erb').humanize.titleize, templates_engine.template_path('') + params[:id] + '/' + ERB::Util.url_encode(child.chomp('.html.erb')), class: 'button button--blue' %>
  <% end %>
</div>
